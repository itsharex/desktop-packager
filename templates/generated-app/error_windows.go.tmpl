package main

import (
	"os"
	"syscall"
	"unsafe"
)

var (
	user32           = syscall.NewLazyDLL("user32.dll")
	procMessageBoxW  = user32.NewProc("MessageBoxW")
)

const (
	MB_OK           = 0x00000000
	MB_ICONERROR    = 0x00000010
	MB_TOPMOST      = 0x00040000
)

func showErrorAndExit(message string) {
	title, _ := syscall.UTF16PtrFromString("错误")
	msg, _ := syscall.UTF16PtrFromString(message)
	procMessageBoxW.Call(0, uintptr(unsafe.Pointer(msg)), uintptr(unsafe.Pointer(title)), MB_OK|MB_ICONERROR|MB_TOPMOST)
	os.Exit(1)
}
